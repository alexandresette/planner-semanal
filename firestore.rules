rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção principal do app
    match /storage/{document=**} {
      // Exige Firebase Auth (anônima ou Google) — bloqueia acesso direto via API/curl
      // O app faz signInAnonymously() automaticamente ao carregar
      allow read, write: if request.auth != null;
    }

    // Bloquear tudo mais por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
